{
  "name": "eu-reg-feed",
  "version": "0.3.0",
  "description": "Open standard and reference implementation for machine-readable EU regulatory change feeds",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "eu-reg-feed": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "fetch": "node dist/cli.js fetch",
    "pretest": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:live": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.live.config.mjs",
    "lint": "eslint .",
    "test:schema": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/schema"
  },
  "keywords": [
    "eu",
    "regulatory",
    "compliance",
    "esma",
    "eba",
    "eiopa",
    "bafin",
    "cssf",
    "aifmd",
    "mifid",
    "open-data",
    "rss",
    "atom",
    "json-feed"
  ],
  "author": "Julian Laycock <julian.laycock@caelith.tech>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/julianlaycock/eu-reg-feed.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0"
  }
}
